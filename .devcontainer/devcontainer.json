{
  "name": "Salary Calculator",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {"codespaces": {"openFiles": ["README.md", "index.html"]}},
  "postAttachCommand": {"server": "python3 -m http.server 8000"},
  "portsAttributes": {"8000": {"label": "Salary Calculator", "onAutoForward": "openPreview"}},
  "forwardPorts": [8000]
}
